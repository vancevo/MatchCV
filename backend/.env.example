APP_ENV=local
OPENROUTER_API_KEY=replace-with-a-new-key
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_TITLE=TalentFlow Recruitment Copilot
DATABASE_URL=sqlite:///./talentflow.db
SUPABASE_URL=
SUPABASE_JWT_SECRET=
AUTH_REQUIRED=false
AUTO_SEED=true
MASTER_SEED_ON_START=false
MAX_UPLOAD_MB=10
REDIS_URL=
QUEUE_NAME=talentflow-screening
QUEUE_EAGER=true
TASK_MAX_ATTEMPTS=3
TASK_TIMEOUT_SECONDS=120
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
INTEGRATION_PROVIDER=local
INTEGRATION_TOKEN_SECRET=replace-with-a-long-random-secret
OAUTH_STATE_SECRET=replace-with-another-long-random-secret
PROVIDER_WEBHOOK_SECRET=replace-with-a-webhook-secret
OPERATIONAL_SWEEP_INTERVAL_MINUTES=15
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/integrations/microsoft/callback
