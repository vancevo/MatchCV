DATABASE_URL=sqlite:///./cv_warehouse.db
AUTH_REQUIRED=false
SUPABASE_URL=
SUPABASE_JWT_SECRET=
CV_STORAGE_DIR=uploads
MAX_UPLOAD_MB=10
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
CV_WAREHOUSE_API_KEY=replace-with-a-long-random-key
CORS_ORIGINS=http://localhost:3100,http://localhost:3000

# Semantic Search lõi: bật khi model đã được tải về.
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_PATH=models/bge-m3
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_PATH=models/bge-reranker-v2-m3
